# Copy this file to .env and fill in the values for your system.

# Game install directory
SIMS4_GAME_DIR=

# .../Documents/Electronic Arts/The Sims 4/Mods
SIMS4_MODS_DIR=

# .../Documents/Electronic Arts/The Sims 4
SIMS4_USER_DIR=

# App-managed mod library (real storage location for installed mods)
LIBRARY_DIR=

# Optional — enables Direct Mode when set to a valid key. Leave empty for Assisted Mode.
CURSEFORGE_API_KEY=

# Watched download folder for Assisted Mode installs. Defaults to ~/Downloads if unset.
DOWNLOAD_WATCH_DIR=

# Auto-detected if possible, otherwise set manually.
GAME_VERSION=

# How many backups to keep per mod under LIBRARY_DIR/.backups/ before older
# ones are purged (each mod replace/update creates one). Defaults to 5.
BACKUP_RETENTION_COUNT=
