# Copy this file to .env and fill in the values for your system.
# SIMS4_GAME_DIR/SIMS4_USER_DIR/LIBRARY_DIR are only the bootstrap values —
# once the app is running, they can also be changed from Settings (which
# migrates any installed mods to the new location automatically).

# Game install directory
SIMS4_GAME_DIR=

# .../Documents/Electronic Arts/The Sims 4 (Mods/ is always this dir's own
# "Mods" subfolder, so there's no separate setting for it)
SIMS4_USER_DIR=

# App-managed mod library (real storage location for installed mods).
# Optional — defaults to ~/.SimsLink/library, alongside the app's database,
# log, and backups (~/.SimsLink/), if left unset.
LIBRARY_DIR=

# Optional — enables Direct Mode when set to a valid key. Leave empty for Assisted Mode.
CURSEFORGE_API_KEY=

# Watched download folder for Assisted Mode installs. Defaults to ~/Downloads if unset.
DOWNLOAD_WATCH_DIR=

# Auto-detected if possible, otherwise set manually.
GAME_VERSION=

# How many backups to keep per mod under LIBRARY_DIR/.backups/ before older
# ones are purged (each mod replace/update creates one). Defaults to 5.
BACKUP_RETENTION_COUNT=

# Real-time watcher for external changes under Mods/ while the app is
# running. 1/true/yes/on or 0/false/no/off. Defaults to true (on).
MODS_WATCHER_ENABLED=

# DEBUG/INFO/WARNING/ERROR/CRITICAL — controls both the log file
# (~/.SimsLink/simslink.log) and console/uvicorn output. Defaults to INFO.
LOG_LEVEL=
